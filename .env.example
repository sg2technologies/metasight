# MetaSight — docker compose environment template
#
# Copy to .env at the repo root (same directory as docker-compose.yml —
# Compose reads it automatically) and fill in real values. Never commit
# the real .env — it's already gitignored.
#
# This is the dev/local quick-start path (`docker compose up`). For a
# hardened bare-metal/VM production install instead, see DEPLOYMENT.md and
# backend/.env.production.example — don't reuse these values there either;
# generate fresh secrets per environment.
#
# Postgres, Redis and Vault hostnames/ports are fixed by the compose
# network topology (postgres/redis/vault service names) and aren't
# configurable here — only the values below.
#
# Generating the CHANGE_ME values below: the "Requirements" line only
# promises Docker, so don't assume Python's installed locally. In order of
# preference:
#   openssl rand -hex 32          # ships with git for Windows / most Linux+macOS
#   docker run --rm python:3.11-slim python -c "import secrets; print(secrets.token_hex(32))"
#                                  # works anywhere Docker itself works — zero other tooling
#   python -c "import secrets; print(secrets.token_hex(32))"   # if you do have Python
# (32 bytes/64 hex chars for SETUP_SECRET and JWT_SECRET_KEY; ENCRYPTION_KEY
# only needs to be >=32 bytes, so `openssl rand -hex 16` — 32 hex chars — is
# the minimum, `-hex 32` is also fine and simpler to remember as "one rule
# for all three".)
#
# A value here is never told to you by MetaSight or discoverable anywhere
# except this file once you set it — it's not a password you'll be asked to
# remember, just a shared secret between whoever filled in this .env and
# whoever later calls POST /auth/setup (including this repo's own
# 'Create your first admin' screen on a fresh install).

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=metadata_db

# ── One-time setup secret — required header to call POST /auth/setup ───────
SETUP_SECRET=CHANGE_ME

# ── JWT signing key ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME

# ── Super Admin (break-glass account) ───────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@your-domain.example
SUPER_ADMIN_PASSWORD=CHANGE_ME

# ── AES-256 encryption key for stored DataSource credentials ────────────────
# Must be at least 32 bytes (64 hex chars) — see the generation note above.
ENCRYPTION_KEY=CHANGE_ME

# ── HashiCorp Vault (dev mode, started by this compose file) ───────────────
# "root" matches the vault service's VAULT_DEV_ROOT_TOKEN_ID in
# docker-compose.yml — change both together if you touch this.
VAULT_TOKEN=root
