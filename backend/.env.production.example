# MetaSight — production environment template
#
# Copy to /etc/metasight/backend.env (referenced by the systemd units in
# deploy/systemd/) with `chmod 600` and an owner of the `metasight` service
# user. Never reuse values from a developer's local backend/.env — generate
# fresh secrets for every environment.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=metasight
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=metasight

# ── One-time setup secret — required header to call POST /auth/setup ───────
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
SETUP_SECRET=CHANGE_ME

# ── JWT signing key ──────────────────────────────────────────────────────────
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME

# ── Super Admin (break-glass account) ───────────────────────────────────────
# Use a long, random, unique password — this path bypasses per-tenant auth
# and is only rate-limited/lockout-protected the same way normal logins are.
SUPER_ADMIN_EMAIL=admin@your-domain.example
SUPER_ADMIN_PASSWORD=CHANGE_ME

# ── AES-256 encryption key for stored DataSource credentials ────────────────
# Must be at least 32 bytes (64 hex chars recommended).
# generate with: python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=CHANGE_ME

# ── Redis (Celery broker + slowapi rate-limit storage) ──────────────────────
REDIS_BROKER_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your actual frontend origin(s) — NOT "*". "*" + credentials is
# treated by Starlette as "any origin, with credentials" (see app/main.py's
# startup warning if this is left as "*").
CORS_ORIGINS=["https://metasight.example.com"]

# ── Environment mode ─────────────────────────────────────────────────────────
# "production" disables /docs, /redoc, /openapi.json.
ENV=production

# ── Policy for unclassified resources (no PolicyRule, not yet scanned) ─────
# "deny" (default, fail-closed) or "allow" (temporary migration aid only).
DEFAULT_UNCLASSIFIED_POLICY=deny

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Native DAM polling interval, seconds (0 = disabled) ─────────────────────
DAM_POLL_INTERVAL_SECONDS=300

# ── Screenshot / session-recording storage ──────────────────────────────────
SCREENSHOT_STORAGE_DIR=/opt/metasight/backend/data/screenshots

# ── Callback URL passed to server-spawned agents (Windows-only local-test
# convenience — see app/core/agent_runner.py). Not used by the real Linux
# agent rollout (backend/agent/install.sh), which takes MS_SERVER directly.
AGENT_CALLBACK_URL=https://metasight.example.com

# ── HashiCorp Vault (optional) ──────────────────────────────────────────────
# Leave both blank to use the built-in AES-256-GCM encrypted_config storage
# (app/core/encryption.py) — the pragmatic default for a single-server
# deployment. Only set these if you're running a real (non-dev-mode) Vault
# cluster; the docker-compose.yml Vault service is dev-mode only
# (in-memory, root token) and must never be used in production.
VAULT_ADDR=
VAULT_TOKEN=
